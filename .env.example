# Configuración de la API de desarrollo. No contiene secretos.
# El script dev:api carga este archivo si se copia a .env en la raíz.
HOST=127.0.0.1
PORT=3001
# Credenciales de aplicación para el cliente web TDLib.
# No son códigos de acceso ni una sesión de usuario. Se quedan en el servidor.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Cliente web con TDLib. Desactivado salvo que se ponga 1.
# No activar en un servidor público hasta revisar aislamiento, cifrado y privacidad.
WRGRAM_TELEGRAM_WEB=0
# Directorio de bases TDLib (ignorado por Git). Cada sesión usa una clave aleatoria.
# WRGRAM_TELEGRAM_DATA_DIR=
# Cookies Secure: obligatorias detrás de HTTPS en producción.
# WRGRAM_TELEGRAM_SECURE_COOKIES=1
# WRGRAM_TELEGRAM_SESSION_TTL_MINUTES=1440
# WRGRAM_TELEGRAM_AUTH_TTL_MINUTES=15
# WRGRAM_TELEGRAM_MAX_SESSIONS=20
# WRGRAM_TELEGRAM_MAX_SESSIONS_PER_IP=3
# Origen exacto permitido además del mismo host (opcional).
# WRGRAM_WEB_ORIGIN=https://wrgram.webrom.cc
# Solo detrás de un proxy inverso de confianza que fije X-Forwarded-For.
# WRGRAM_TRUST_PROXY=0

# Proveedor explícito. No hay cambio automático ni respaldo que envíe tus datos.
WRGRAM_AI_PROVIDER=groq
GROQ_API_KEY=
WRGRAM_GROQ_MODEL=openai/gpt-oss-20b

# Alternativa local: cambiar WRGRAM_AI_PROVIDER a ollama.
WRGRAM_OLLAMA_URL=http://127.0.0.1:11434
WRGRAM_AI_MODEL=qwen3:1.7b

# En producción web, usar un proxy HTTPS del mismo origen para /api.
# VITE_WRGRAM_API_URL es público, nunca poner tokens o contraseñas aquí.
# VITE_WRGRAM_API_URL=/api
# Incluir la vista web TDLib en el build de producción solo si el backend está desplegado.
# VITE_WRGRAM_TELEGRAM_WEB=1
