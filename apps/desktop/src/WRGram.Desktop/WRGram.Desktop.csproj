<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="WTelegramClient" Version="4.4.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\mobile-ui\dist\**\*"
                      LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\..\..\.private\desktop-telegram.json')">
    <EmbeddedResource Include="..\..\..\..\.private\desktop-telegram.json"
                      LogicalName="telegram.embedded.json" />
  </ItemGroup>

</Project>
